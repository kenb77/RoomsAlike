# Postgres (docker-compose default shown below)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/airbnb_clone"

# NextAuth
NEXTAUTH_SECRET="replace-with-a-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Monthly fee charged to hosts per active listing, in cents (e.g. 2000 = $20.00/month)
LISTING_POST_FEE_CENTS=2000
